#!/bin/bash
set -e

DATADIR="@DATADIR@"
SOURCE_DATA_DIR="@SOURCE_DATA_DIR@"
SCHEMA_ID="org.github.kai66673.iide"

# при `sudo meson install` $HOME указывает на root — целимся в домашний каталог реального пользователя
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    REAL_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
else
    REAL_HOME="$HOME"
fi

LOCAL_SCHEMA_DIR="$REAL_HOME/.local/share/glib-2.0/schemas"
LOCAL_ICON_DIR="$REAL_HOME/.local/share/icons/hicolor"
CURRENT_DIR="$(cd "$(dirname "$0")" && pwd)"

install_schemas() {
    mkdir -p "$LOCAL_SCHEMA_DIR"
    # meson запускает скрипт из корня каталога сборки — исходных XML там нет,
    # поэтому ищем схему в установленном datadir и в исходном дереве проекта
    for SRC in \
        "$DATADIR/glib-2.0/schemas/$SCHEMA_ID.gschema.xml" \
        "$SOURCE_DATA_DIR/$SCHEMA_ID.gschema.xml" \
        "$CURRENT_DIR/data/$SCHEMA_ID.gschema.xml"; do
        if [ -f "$SRC" ]; then
            cp "$SRC" "$LOCAL_SCHEMA_DIR/"
            glib-compile-schemas "$LOCAL_SCHEMA_DIR"
            echo "GSettings schemas installed to $LOCAL_SCHEMA_DIR (from $SRC)"
            return 0
        fi
    done
    # раньше при промахе молча компилировалась пустая папка — теперь явная ошибка
    echo "ERROR: $SCHEMA_ID.gschema.xml not found in:" >&2
    echo "  $DATADIR/glib-2.0/schemas/" >&2
    echo "  $SOURCE_DATA_DIR/" >&2
    echo "  $CURRENT_DIR/data/" >&2
    exit 1
}

install_icons() {
    # в build/data/icons лежат только пустые каталоги — источник иконок тоже в исходном дереве
    for ICON_ROOT in "$SOURCE_DATA_DIR/icons" "$CURRENT_DIR/data/icons"; do
        if [ -d "$ICON_ROOT" ] && [ -n "$(find "$ICON_ROOT" -name '*.svg' -print -quit 2>/dev/null)" ]; then
            mkdir -p "$LOCAL_ICON_DIR"
            cp -r "$ICON_ROOT/"* "$LOCAL_ICON_DIR/" 2>/dev/null || true
            gtk-update-icon-cache "$LOCAL_ICON_DIR" 2>/dev/null || true
            echo "Icons installed to $LOCAL_ICON_DIR (from $ICON_ROOT)"
            return 0
        fi
    done
}

echo "Installing iide settings locally for development..."
install_schemas
install_icons
echo "Done! GIO подхватывает ~/.local/share/glib-2.0/schemas автоматически, без XDG_DATA_DIRS."
